# Free/account-based asset source API keys.
# Leave blank until you create the relevant free developer account/key.

# Stock photos/video search
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Music/SFX/audio search
# Freesound's "Client secret / API key" is the token-auth API key.
# Prefer FREESOUND_CLIENT_SECRET; FREESOUND_API_KEY is kept as a legacy alias.
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
FREESOUND_REDIRECT_URI=http://freesound.org/home/app_permissions/permission_granted/
FREESOUND_ACCESS_TOKEN=
FREESOUND_REFRESH_TOKEN=

# Icons
NOUNPROJECT_API_KEY=
NOUNPROJECT_API_SECRET=
ICONFINDER_API_KEY=

# Maps/charts/data
MAPBOX_ACCESS_TOKEN=
MAPTILER_API_KEY=
DATAWRAPPER_API_TOKEN=
FRED_API_KEY=
DATA_GOV_API_KEY=

# Public/CC video platforms that may need account tokens for API access
VIMEO_ACCESS_TOKEN=

# Museum/open collection APIs that may require free registration
SMITHSONIAN_API_KEY=

# Deepgram speech services
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_CONTAINER=
DEEPGRAM_TTS_ENCODING=mp3
DEEPGRAM_TTS_SAMPLE_RATE=
DEEPGRAM_TTS_BIT_RATE=
DEEPGRAM_TTS_MIP_OPT_OUT=false
